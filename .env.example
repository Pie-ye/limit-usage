# Server
HOST=0.0.0.0
PORT=50048
POLL_INTERVAL_SECONDS=60

# SQLite
DATABASE_PATH=./data/usage.db

# Codex (ChatGPT OAuth auth.json from `codex login`)
CODEX_AUTH_PATH=~/.codex/auth.json

# SuperGrok (from `grok login` or Grok Build CLI)
GROK_AUTH_PATH=~/.grok/auth.json
# Optional fallback session cookie for grok.com billing
# SUPERGROK_COOKIE=

# DeepSeek API
# DEEPSEEK_API_KEY=sk-...

# Antigravity (Google OAuth; run scripts/antigravity_login.py once)
# Defaults to ~/.gemini/antigravity-acp/acp_token.json
# ANTIGRAVITY_TOKEN_PATH=~/.gemini/antigravity-acp/acp_token.json

# Claude — the card is fed from two local files written by Claude Code tooling,
# no API calls. See README "Claude quota sources".
# Official windows recorded from headless sessions' stream-json rate_limit_event
# by deploy/claude-rate-tap (enabled via deploy/codeg-claude-rate-tap.conf).
# CLAUDE_STREAM_CAPTURE_PATH=~/.claude-monitor/stream/latest.json
# Official rate_limits captured by the `claude-monitor --statusline` hook.
# CLAUDE_STATUSLINE_CAPTURE_PATH=~/.claude-monitor/statusline/latest.json
# Claude Code's own usage cache, copied out of ~/.claude.json by
# deploy/claude-usage-cache-sync.py (see the systemd timer in deploy/).
# CLAUDE_USAGE_CACHE_PATH=~/.claude-monitor/state/claude-code-usage.json
# Older than this and a local file is ignored; with neither usable the
# provider falls back to the rate-limited OAuth endpoint.
# CLAUDE_OFFICIAL_MAX_AGE_SECONDS=21600
# Minimum spacing between OAuth fallback calls.
# CLAUDE_OAUTH_MIN_INTERVAL_SECONDS=1800
# Used by the OAuth fallback and for the tier hint on the card.
# CLAUDE_CREDENTIALS_PATH=~/.claude/.credentials.json
