# Server
HOST=0.0.0.0
PORT=50048
POLL_INTERVAL_SECONDS=60

# SQLite
DATABASE_PATH=./data/usage.db

# Codex (ChatGPT OAuth auth.json from `codex login`)
CODEX_AUTH_PATH=~/.codex/auth.json

# SuperGrok (from `grok login` or Grok Build CLI)
GROK_AUTH_PATH=~/.grok/auth.json
# Optional fallback session cookie for grok.com billing
# SUPERGROK_COOKIE=

# DeepSeek API
# DEEPSEEK_API_KEY=sk-...

# Antigravity (Google OAuth; run scripts/antigravity_login.py once)
# Defaults to ~/.gemini/antigravity-acp/acp_token.json
# ANTIGRAVITY_TOKEN_PATH=~/.gemini/antigravity-acp/acp_token.json

# Claude — primary source is claude-monitor's state file (no API calls).
# See README "Claude quota via claude-monitor" for the statusline hook + timer.
# CLAUDE_MONITOR_STATE_PATH=~/.claude-monitor/state/latest.json
# Older than this and the state file is ignored in favour of the OAuth fallback.
# CLAUDE_MONITOR_MAX_AGE_SECONDS=900
# Per-model weekly window (Fable) is OAuth-only; refreshed rarely and merged
# into the claude-monitor windows. 0 disables it.
# CLAUDE_SCOPED_REFRESH_SECONDS=1800
# CLAUDE_SCOPED_MAX_AGE_SECONDS=7200
# Used by the OAuth fallback and the Fable window refresh.
# CLAUDE_CREDENTIALS_PATH=~/.claude/.credentials.json
