# Server
HOST=0.0.0.0
PORT=50048
POLL_INTERVAL_SECONDS=60

# SQLite
DATABASE_PATH=./data/usage.db

# Codex (ChatGPT OAuth auth.json from `codex login`)
CODEX_AUTH_PATH=~/.codex/auth.json

# SuperGrok (from `grok login` or Grok Build CLI)
GROK_AUTH_PATH=~/.grok/auth.json
# Optional fallback session cookie for grok.com billing
# SUPERGROK_COOKIE=

# DeepSeek API
# DEEPSEEK_API_KEY=sk-...
