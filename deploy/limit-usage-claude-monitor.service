[Unit]
Description=Sync Claude Code usage cache for the limit-usage Claude card

[Service]
Type=oneshot
# Copies cachedUsageUtilization out of ~/.claude.json into the directory the
# container mounts. Claude Code rewrites ~/.claude.json via rename, so a
# single-file bind mount would go stale; a periodic copy sidesteps that.
# No network calls.
ExecStart=/usr/bin/python3 %h/Container/limit-usage/deploy/claude-usage-cache-sync.py
StandardOutput=null
TimeoutStartSec=60

[Install]
WantedBy=default.target
