[Unit]
Description=Sync Claude Code usage cache every 2 minutes

[Timer]
OnBootSec=1min
OnUnitActiveSec=2min
# Keep this well under CLAUDE_OFFICIAL_MAX_AGE_SECONDS (default 21600) so the copy never becomes the reason the card goes stale.
AccuracySec=15s
Unit=limit-usage-claude-monitor.service

[Install]
WantedBy=timers.target
